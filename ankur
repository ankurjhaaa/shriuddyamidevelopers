function isPortAvailable($host, $port) {
    $connection = @fsockopen($host, $port, $errno, $errstr, 1);
    if (is_resource($connection)) {
        fclose($connection);
        return false; // Port is in use
    }
    return true; // Port is available
}

echo "{$cCyan}[*] Hunting for an empty portal (port)...{$cReset}\n";

while ($port <= $maxPort) {
    if (isPortAvailable($host, $port)) {
        echo "{$cGreen}{$cBold}[✔] Portal found at port {$port}!{$cReset}\n\n";
        echo "{$cYellow}===================================================={$cReset}\n";
        echo " 🚀 {$cGreen}{$cBold} Server is LIVE and kicking!{$cReset}\n";
        echo " 🌍 {$cBlue}{$cBold} URL: http://{$host}:{$port}{$cReset}\n";
        echo " 🛑 {$cRed}{$cBold} Press Ctrl+C when you're done coding.{$cReset}\n";
        echo "{$cYellow}===================================================={$cReset}\n\n";
        
        $command = sprintf("php -S %s:%d", $host, $port);
        passthru($command, $return_var);
        exit($return_var);
    }
    echo "{$cRed}[X] Port {$port} is busy doing other stuff, trying next...{$cReset}\n";
    $port++;
}

echo "\n{$cRed}{$cBold}[!] ALL PORTS ARE BUSY! Did you open a portal to another dimension?{$cReset}\n";
